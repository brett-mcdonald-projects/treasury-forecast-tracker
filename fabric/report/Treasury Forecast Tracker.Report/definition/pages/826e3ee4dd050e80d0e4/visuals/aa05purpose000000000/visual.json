            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Purpose and function",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#1F3864"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "What it does: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt"
                    }
                  },
                  {
                    "value": "Compares the Treasury's three most recent forecast rounds across eight headline economic and fiscal measures.",
                    "textStyle": {
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Why: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt"
                    }
                  },
                  {
                    "value": "To show how the outlook was revised from one round to the next, without opening three sets of tables.",
                    "textStyle": {
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use it: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt"
                    }
                  },
                  {
                    "value": "Select a measure above. The chart traces each round, the note above it states what changed in the latest round, and the table gives the figures. Data logs shows what the pipeline loaded and the checks it passed.",
                    "textStyle": {
                      "fontSize": "9pt"
                    }
                  }
                ]
              }
            ]
